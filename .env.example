# =============================================================================
# View Point Public School — environment variables (NAMES ONLY, no secrets).
# Copy to `.env` for local dev and set real values in the Netlify dashboard for
# deploys. NEVER commit a filled-in .env. See docs/ENV_GUIDE.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend-safe. Anything VITE_-prefixed is compiled into the browser bundle and
# is therefore PUBLIC. Only put values here that are safe to expose publicly.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Canonical public site URL, e.g. https://www.example.com. The domain is
# UNCONFIRMED — do not hard-code it anywhere; always read VITE_SITE_URL.
VITE_SITE_URL=
# Cloudflare Turnstile PUBLIC site key (safe to expose).
VITE_TURNSTILE_SITE_KEY=

# -----------------------------------------------------------------------------
# Server-only. These MUST NOT be VITE_-prefixed and MUST NOT reach the browser.
# Set them only in the Netlify environment (Functions runtime).
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=
TURNSTILE_SECRET_KEY=

# Optional: comma-separated allowlist of origins permitted to call Functions.
# Defaults to VITE_SITE_URL when unset. Preview deploys may add their URL here.
ALLOWED_ORIGINS=
